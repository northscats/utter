modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "artifacts/mockup-sandbox: Component Preview Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "XegfDyZt7HqfW2Bb8Ghoy"
isCanvasWorkflow = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mockup-sandbox run dev"
cwd = "./artifacts/mockup-sandbox"
waitForPort = 8081
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "8081"
BASE_PATH = "/__mockup"

[[workflows.workflow]]
name = "artifacts/osv-app: web"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/osv-app"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/run-osv.sh"
cwd = "./artifacts/osv-app"
waitForPort = 21844
ensurePreviewReachable = "/healthz"
router = "path"

[workflows.workflow.tasks.env]
PORT = "21844"
BASE_PATH = "/"

[[workflows.workflow]]
name = "artifacts/api-server: API Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "3B4_FFSkEVBkAeYMFRJ2e"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run dev"
cwd = "./artifacts/api-server"
waitForPort = 8080
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "8080"

[[workflows.workflow]]
name = "Run"
mode = "sequential"
author = 55001033

[[workflows.workflow.tasks]]
task = "workflow.run"
args = ""

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "cash-visual"

[[workflows.workflow]]
name = "cash-visual"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd osv-dashboard && python test_cash_indicators_browser.py --public-preview"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000


[nix]
channel = "stable-25_05"
packages = ["libreoffice", "tesseract"]

[userenv]

[userenv.shared]
ENCRYPTION_KEY = "bDy8qWKNCy1e9xiTEkLnXQj3quVvmffN92WvHFHXC-o="
ADMIN_INITIAL_PASSWORD = "admin123admin"
OPERATOR_PASSWORD_RESET = "oper123oper"

[userenv.development]
ONE_C_ENV = "development"
ONE_C_TRUSTED_PROXY_CIDRS = "127.0.0.1/32,::1/128"

[userenv.production]
ONE_C_ENV = "production"
ONE_C_PUBLIC_BASE_URL = "https://gisuzter.replit.app"
ONE_C_TRUSTED_PROXY_CIDRS = "127.0.0.1/32,::1/128"
LIMITS_MAX_WEBHOOK_URL = "https://gisuzter.replit.app/limit-notifications/max/webhook"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 21844
externalPort = 80
