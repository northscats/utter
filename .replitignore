# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local

# Runtime data is restored from App Storage and must not be copied into the
# deployment image.
osv-dashboard/uploads
osv-dashboard/output
attached_assets

# Development caches and generated bytecode.
.cache
.pytest_cache
__pycache__
*.pyc
reports
screenshots
exports
