# Скопируйте в .env и заполните реальными значениями
# cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=osv_user
POSTGRES_PASSWORD=СМЕНИТЕ_ПАРОЛЬ
POSTGRES_DB=osv_db

# --- Flask ---
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=СЛУЧАЙНАЯ_СТРОКА_МИНИМУМ_32_СИМВОЛА
# Только для чистой базы: секрет не менее 15 Unicode-символов; не логируется.
# Существующая база этот параметр не использует.
INITIAL_ADMIN_PASSWORD=ЗАДАЙТЕ_СЕКРЕТНУЮ_ФРАЗУ_НЕ_МЕНЕЕ_15_СИМВОЛОВ

# --- Приложение ---
# Порт на хосте (контейнер всегда слушает 8080 внутри)
APP_PORT=4545

# Подпуть за прокси. Если приложение в корне — оставьте пустым
SCRIPT_NAME=/osv

# Руководительский режим исторической аналитики.
# 0 возвращает прежний экспертный начальный экран без изменения данных.
HISTORICAL_EXECUTIVE_ENABLED=1

# Число воркеров gunicorn (рекомендуется: 2–4)
GUNICORN_WORKERS=2
